include=~/.local/share/omarchy/default/mako/core.ini

# Always use mako's own timeout; ignore the expire_timeout sent by apps.
# Without this, web apps can send expire_timeout=-1
# which makes notifications stay forever until manually dismissed.
ignore-timeout=1
max-visible=3
height=104

text-color=#cdd6f4
border-color=#89b4fa
background-color=#1e1e2e

[app-name=Chromium body~="(mail\\.google\\.com|gmail\\.com|Gmail|gmail)"]
format=<b>%s</b>\n%b

[app-name=Chromium summary~="(Gmail|gmail)"]
format=<b>%s</b>\n%b

[desktop-entry=chromium body~="(mail\\.google\\.com|gmail\\.com|Gmail|gmail)"]
format=<b>%s</b>\n%b

[app-name=Chromium body~="(web\\.whatsapp\\.com|WhatsApp|Whatsapp|whatsapp)"]
format=<b>%s</b>\n%b

[app-name=Chromium summary~="(WhatsApp|Whatsapp|whatsapp)"]
format=<b>%s</b>\n%b

[desktop-entry=chromium body~="(web\\.whatsapp\\.com|WhatsApp|Whatsapp|whatsapp)"]
format=<b>%s</b>\n%b
