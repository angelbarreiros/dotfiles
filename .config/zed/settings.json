// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    }
  },
  "tab_size": 4,
  "hard_tabs": false,
  "detect_indentation": false,
  "languages": {
    "HTML": {
      "tab_size": 2,
      "hard_tabs": false,
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "JavaScript": {
      "tab_size": 4,
      "hard_tabs": false,
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "JSX": {
      "tab_size": 4,
      "hard_tabs": false,
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "TypeScript": {
      "tab_size": 4,
      "hard_tabs": false,
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "TSX": {
      "tab_size": 4,
      "hard_tabs": false,
      "formatter": "language_server",
      "format_on_save": "on"
    }
  },

  "cli_default_open_behavior": "new_window",
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": "Material Icon Theme",
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "agent": {
    "tool_permissions": {
      "tools": {
        "create_directory": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^SSG/frontend/src/components/"
            }
          ]
        },
        "search_web": {
          "default": "allow"
        }
      }
    },
    "sidebar_side": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6",
      "enable_thinking": true
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "project_panel": {
    "dock": "left"
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
